<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AniSync.Next</AssemblyName>
    <RootNamespace>AniSync.Next</RootNamespace>
    <DevelopmentBuildNumber Condition="'$(DevelopmentBuildNumber)' == ''">0</DevelopmentBuildNumber>
    <Version>0.1.0-dev.$(DevelopmentBuildNumber)</Version>
    <AssemblyVersion>0.1.0.$(DevelopmentBuildNumber)</AssemblyVersion>
    <FileVersion>0.1.0.$(DevelopmentBuildNumber)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <ReleaseChannel>Dev</ReleaseChannel>
    <RepositoryUrl>https://github.com/JosephZurita/AniSync-Next</RepositoryUrl>
  </PropertyGroup>

  <Target Name="ValidateDevelopmentBuildNumber" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_IsNumericDevelopmentBuildNumber>$([System.Text.RegularExpressions.Regex]::IsMatch('$(DevelopmentBuildNumber)', '^[0-9]+$'))</_IsNumericDevelopmentBuildNumber>
    </PropertyGroup>
    <Error Condition="'$(_IsNumericDevelopmentBuildNumber)' != 'True'"
           Text="DevelopmentBuildNumber must be a non-negative integer; received '$(DevelopmentBuildNumber)'." />
    <Error Condition="'$(_IsNumericDevelopmentBuildNumber)' == 'True' And $([System.Int32]::Parse('$(DevelopmentBuildNumber)')) &gt; 65534"
           Text="DevelopmentBuildNumber $(DevelopmentBuildNumber) exceeds the CLR AssemblyVersion revision limit of 65534." />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.84" />
    <PackageReference Include="Shoko.BuildTools.Targets" Version="0.2.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AniSync.Next.Tests" />
    <EmbeddedResource Include="wwwroot\app\**\*">
      <LogicalName>app/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

